# ============================================================
# public/.htaccess  →  dist/.htaccess (Vite lo copia automaticamente)
# Root del sito su Aruba: public_html/.htaccess
#
# Scopo: fare in modo che ricaricare una pagina React (es. /statistiche)
# non dia 404, perché Apache cerca un file fisico che non esiste.
# ============================================================

Options -Indexes -MultiViews
RewriteEngine On
RewriteBase /

# ── Serve i file statici esistenti (JS, CSS, immagini, ecc.) ──
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ── Le richieste /api/* vengono gestite dal .htaccess in api/ ──
RewriteRule ^api/ - [L]

# ── Tutto il resto → index.html (React Router gestisce il routing) ──
RewriteRule ^ index.html [L]
