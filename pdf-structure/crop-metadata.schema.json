{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BasketPdfStats Crop Metadata",
  "description": "Schema for calibrated crop-metadata.json generated by pdf_crop_runner.calibrate_layout.",
  "type": "object",
  "required": [
    "schemaVersion",
    "engine",
    "outputKind",
    "isFinalNormalizedJson",
    "createdAtUtc",
    "input",
    "documentFileName",
    "documentHash",
    "sourcePdf",
    "sourceFileName",
    "sourceHash",
    "originalFileName",
    "pageIndex",
    "renderDpi",
    "renderScale",
    "renderedImageWidth",
    "renderedImageHeight",
    "layoutMapVersion",
    "layoutMapName",
    "layoutMapPath",
    "outputFolder",
    "imageOutputFolder",
    "inputMode",
    "durationMs",
    "pages",
    "crops",
    "artifacts",
    "layoutCalibration",
    "warnings",
    "errors"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "engine": {
      "type": "string",
      "enum": [
        "LayoutCalibration",
        "LayoutCropPreparer"
      ]
    },
    "outputKind": {
      "type": "string",
      "const": "LayoutCropPreparation"
    },
    "isFinalNormalizedJson": {
      "type": "boolean",
      "const": false
    },
    "createdAtUtc": {
      "type": "string"
    },
    "input": {
      "type": "object",
      "required": [
        "path",
        "exists",
        "suffix"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "exists": {
          "type": "boolean"
        },
        "suffix": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "documentFileName": {
      "type": "string"
    },
    "documentHash": {
      "type": "string"
    },
    "sourcePdf": {
      "type": "string"
    },
    "sourceFileName": {
      "type": "string"
    },
    "sourceHash": {
      "type": "string"
    },
    "originalFileName": {
      "type": "string"
    },
    "pageIndex": {
      "type": "integer",
      "minimum": 0
    },
    "renderDpi": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "renderScale": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "renderedImageWidth": {
      "type": "integer",
      "minimum": 0
    },
    "renderedImageHeight": {
      "type": "integer",
      "minimum": 0
    },
    "layoutMapVersion": {
      "type": "string"
    },
    "layoutMapName": {
      "type": "string"
    },
    "layoutMapPath": {
      "type": "string"
    },
    "outputFolder": {
      "type": "string"
    },
    "imageOutputFolder": {
      "type": "string"
    },
    "inputMode": {
      "type": "string",
      "enum": [
        "FullPage",
        "Crops",
        "Both"
      ]
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "crops": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/crop"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "layoutCalibration": {
      "type": "object",
      "required": [
        "status",
        "mode",
        "sourceGeometryPath",
        "reportPath",
        "cropOverlayBeforePath",
        "cropOverlayAfterPath",
        "contactSheetAfterPath",
        "runtimeLayoutMapPath",
        "rulesPath",
        "detectedAnchorsPath"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "Calibrated",
            "Partial",
            "Failed"
          ]
        },
        "mode": {
          "type": "string"
        },
        "sourceGeometryPath": {
          "type": "string"
        },
        "reportPath": {
          "type": "string"
        },
        "cropOverlayBeforePath": {
          "type": "string"
        },
        "cropOverlayAfterPath": {
          "type": "string"
        },
        "contactSheetAfterPath": {
          "type": "string"
        },
        "runtimeLayoutMapPath": {
          "type": "string"
        },
        "rulesPath": {
          "type": "string"
        },
        "detectedAnchorsPath": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "warnings": {
      "$ref": "#/$defs/stringArray"
    },
    "errors": {
      "$ref": "#/$defs/stringArray"
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "page": {
      "type": "object",
      "required": [
        "pageNumber",
        "imagePath",
        "width",
        "height",
        "source"
      ],
      "properties": {
        "pageNumber": {
          "type": "integer",
          "minimum": 1
        },
        "imagePath": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "crop": {
      "type": "object",
      "required": [
        "cropId",
        "fileName",
        "zoneId",
        "zoneType",
        "tier",
        "cropType",
        "side",
        "expectedContentType",
        "pageIndex",
        "pageNumber",
        "coordinateUnit",
        "rectNormalized",
        "rectPixels",
        "pixelBox",
        "pixelX",
        "pixelY",
        "pixelWidth",
        "pixelHeight",
        "imagePath",
        "fieldIds",
        "statKeys",
        "source",
        "parentZoneId",
        "deriveMode",
        "semanticRole",
        "isPlaceholder",
        "usable",
        "calibrationStatus",
        "calibrationWarnings",
        "calibrationErrors"
      ],
      "properties": {
        "cropId": {
          "type": "string"
        },
        "fileName": {
          "type": "string"
        },
        "zoneId": {
          "type": "string"
        },
        "zoneType": {
          "type": "string"
        },
        "tier": {
          "type": "string",
          "enum": [
            "macro",
            "semantic"
          ]
        },
        "cropType": {
          "type": "string"
        },
        "side": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Home",
            "Away",
            null
          ]
        },
        "expectedContentType": {
          "type": "string"
        },
        "pageIndex": {
          "type": "integer",
          "minimum": 0
        },
        "pageNumber": {
          "type": "integer",
          "minimum": 1
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "coordinateUnit": {
          "type": "string",
          "enum": [
            "normalized",
            "pixel",
            "relative-to-parent"
          ]
        },
        "rectNormalized": {
          "$ref": "#/$defs/rectNormalized"
        },
        "rectPixels": {
          "$ref": "#/$defs/rectPixels"
        },
        "pixelBox": {
          "$ref": "#/$defs/rectPixels"
        },
        "pixelX": {
          "type": "integer",
          "minimum": 0
        },
        "pixelY": {
          "type": "integer",
          "minimum": 0
        },
        "pixelWidth": {
          "type": "integer",
          "minimum": 1
        },
        "pixelHeight": {
          "type": "integer",
          "minimum": 1
        },
        "imagePath": {
          "type": "string"
        },
        "fieldIds": {
          "$ref": "#/$defs/stringArray"
        },
        "statKeys": {
          "$ref": "#/$defs/stringArray"
        },
        "source": {
          "type": "string"
        },
        "parentZoneId": {
          "type": "string"
        },
        "deriveMode": {
          "type": "string"
        },
        "semanticRole": {
          "type": "string"
        },
        "isPlaceholder": {
          "type": "boolean"
        },
        "usable": {
          "type": "boolean"
        },
        "calibrationStatus": {
          "type": "string",
          "enum": [
            "Calibrated",
            "Failed"
          ]
        },
        "calibrationWarnings": {
          "$ref": "#/$defs/stringArray"
        },
        "calibrationErrors": {
          "$ref": "#/$defs/stringArray"
        }
      },
      "additionalProperties": true
    },
    "artifact": {
      "type": "object",
      "required": [
        "artifactType",
        "path",
        "pageNumber",
        "width",
        "height",
        "zoneId"
      ],
      "properties": {
        "artifactType": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "pageNumber": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "integer",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "minimum": 0
        },
        "zoneId": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "rectNormalized": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "rectPixels": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
