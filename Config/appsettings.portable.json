{
  "runtime": {
    "runtimeRoot": "runtime",
    "workingFolder": "Working",
    "outputJsonFolder": "OutputJson",
    "logsFolder": "Logs",
    "datasetFolder": "Dataset",
    "debugFolder": "Debug",
    "validationDebugFolder": "Validation"
  },
  "ocr": {
    "continueOnEngineFailure": true,
    "enabledEngines": [
      "TesseractFullPage",
      "TesseractLayoutCrops",
      "PaddleLayoutCrops",
      "PaddleTableRows"
    ],
    "tesseractPython": {
      "enabled": true,
      "pythonExecutablePath": "tools\\python-tesseract\\Scripts\\python.exe",
      "pythonProjectPath": "fiba_pdf_to_json_programma_v2",
      "workerModule": "fiba_pdf_to_json.worker",
      "timeoutSeconds": 180,
      "fallbackScale": 4,
      "useNativeImages": true,
      "verbose": false,
      "mode": "FullPage",
      "useLayoutCrops": true,
      "preprocessImages": false,
      "savePreprocessedImages": false,
      "preprocessScale": 2,
      "preprocessThreshold": 170,
      "preprocessSharpen": true,
      "cropWorkerModule": "fiba_pdf_to_json.crop_worker",
      "cropRawOutputFolder": "runtime/Dataset/OcrRaw/TesseractLayoutCrops",
      "preprocessedCropOutputFolder": "runtime/Dataset/Preprocessed/TesseractCrops",
      "rawOutputFolder": "runtime/Dataset/OcrRaw/TesseractFullPage",
      "debugOutputFolder": "runtime/Dataset/TesseractFullPageDebug",
      "layoutDebugOutputFolder": "runtime/Dataset/LayoutDebug",
      "tesseractExecutableFolder": "tools\\tesseract",
      "tessdataPrefix": "tools\\tesseract\\tessdata"
    },
    "paddleCrop": {
      "enabled": true,
      "pythonExecutablePath": "tools\\python-paddle\\Scripts\\python.exe",
      "pythonProjectPath": "fiba_pdf_to_json_programma_v2",
      "workerModule": "fiba_pdf_to_json.paddle_crop_worker",
      "rowWorkerModule": "fiba_pdf_to_json.paddle_row_worker",
      "lang": "en",
      "modelDir": "",
      "timeoutSeconds": 300,
      "rawOutputFolder": "runtime/Dataset/OcrRaw/PaddleLayoutCrops",
      "rowRawOutputFolder": "runtime/Dataset/OcrRaw/PaddleTableRows"
    }
  },
  "layoutPreparation": {
    "enabled": true,
    "prepareCropsIfMissing": true,
    "pythonExecutablePath": "tools\\python-tesseract\\Scripts\\python.exe",
    "workingDirectory": "pdf_crop_runner",
    "workerModule": "pdf_crop_runner.calibrate_layout",
    "layoutMapPath": "pdf-structure/layout-map.default.json",
    "calibrationRulesPath": "pdf-structure/layout-calibration-rules.json",
    "cropOutputFolder": "runtime/Dataset/LayoutCrops",
    "imageOutputFolder": "runtime/Dataset/LayoutImages",
    "maxPages": 1,
    "timeoutSeconds": 120,
    "layoutDebugOutputFolder": "runtime/Dataset/LayoutDebug",
    "requireFullPageGeometry": true
  },
  "ocrApi": {
    "baseUrl": "",
    "token": "",
    "matchLookupDate": "2026-07-10"
  },
  "reconciliation": {
    "engineWeights": {
      "defaultWeight": 1.0,
      "engines": {
        "ocr.tesseract.fullpage": { "statWeight": 0.5, "scoreWeight": 0.7, "defaultWeight": 0.6 },
        "ocr.tesseract.crop": { "statWeight": 0.85, "scoreWeight": 1.0, "defaultWeight": 0.85 },
        "ocr.paddle.crop": { "statWeight": 0.9, "scoreWeight": 0.95, "defaultWeight": 0.9 },
        "ocr.paddle.row": { "statWeight": 1.0, "scoreWeight": 0.8, "defaultWeight": 1.0 }
      }
    }
  }
}
