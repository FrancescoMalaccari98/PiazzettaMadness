<UserControl x:Class="PiazzettaMadness.App.Controls.TimePickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="34"
             Width="136">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="58" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="58" />
        </Grid.ColumnDefinitions>
        <ComboBox x:Name="HourCombo" Height="34" SelectionChanged="TimePart_SelectionChanged" />
        <TextBlock Grid.Column="1" Text=":" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <ComboBox x:Name="MinuteCombo" Grid.Column="2" Height="34" SelectionChanged="TimePart_SelectionChanged" />
    </Grid>
</UserControl>
