<Window x:Class="PiazzettaMadness.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Piazzetta Madness - Console"
        Height="720"
        Width="1500"
        MinHeight="640"
        MinWidth="1200"
        Background="#f4f6f8"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
        <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Piazzetta Madness" FontSize="22" FontWeight="Bold" Foreground="#111827" />
                <TextBlock x:Name="DatabasePathText" Visibility="Collapsed" Margin="0,4,0,0" Foreground="#4b5563" />
            </StackPanel>
            <Button x:Name="OpenScoreboardButton"
                    DockPanel.Dock="Right"
                    Width="150"
                    Height="34"
                    HorizontalAlignment="Right"
                    Background="#2563eb"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Content="Apri tabellone"
                    Click="OpenScoreboard_Click" />
        </DockPanel>

        <TabControl x:Name="MainTabControl" Grid.Row="1">
            <TabItem x:Name="LiveTabItem" Header="Partita live">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="1.15*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Modalità" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="LiveModeCombo"
                                      Width="120"
                                      SelectedIndex="0"
                                      SelectionChanged="LiveModeCombo_SelectionChanged"
                                      Margin="0,0,16,0">
                                <ComboBoxItem Content="Partita DB" Tag="Database" />
                                <ComboBoxItem Content="Libera" Tag="Free" />
                                <ComboBoxItem Content="3 Point Contest" Tag="ThreePointContest" />
                            </ComboBox>
                            <TextBlock x:Name="LiveMatchLabel" Text="Partita" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="LiveMatchCombo"
                                      Width="420"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="LiveMatchCombo_SelectionChanged" />
                            <CheckBox x:Name="AnimationsEnabledCheckBox"
                                      Content="Animazioni"
                                      IsChecked="True"
                                      VerticalAlignment="Center"
                                      Margin="18,0,0,0"
                                      FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Border x:Name="LiveSyncStatusBorder" Padding="8,6" Margin="0,0,6,0" Background="#e5e7eb" BorderBrush="#cbd5e1" BorderThickness="1">
                                <TextBlock x:Name="LiveSyncStatusText" Text="Sync: nessuna modifica" FontWeight="SemiBold" Foreground="#334155" />
                            </Border>
                            <Border Padding="8,6" Margin="0,0,6,0" Background="#e5e7eb" BorderBrush="#cbd5e1" BorderThickness="1">
                                <TextBlock x:Name="LiveMatchStatusText" Text="Stato: -" FontWeight="SemiBold" Foreground="#111827" />
                            </Border>
                            <Button x:Name="PrepareMatchButton" Content="Prepara" Width="76" Height="34" Margin="0,0,4,0" Click="PrepareMatch_Click" />
                            <Button x:Name="StartMatchButton" Content="Inizia" Width="76" Height="34" Margin="0,0,4,0" Click="StartMatch_Click" />
                            <Button x:Name="PauseMatchButton" Content="Pausa" Width="76" Height="34" Margin="0,0,4,0" Click="PauseMatch_Click" />
                            <Button x:Name="ResumeMatchButton" Content="Riprendi" Width="76" Height="34" Margin="0,0,4,0" Click="ResumeMatch_Click" />
                            <Button x:Name="FinishMatchButton" Content="Chiudi" Width="76" Height="34" Click="FinishMatch_Click" />
                        </StackPanel>
                    </DockPanel>

                    <Border x:Name="HomeLivePanel" Grid.Row="1" Grid.Column="0" Padding="12" Background="White" BorderBrush="#d1d5db" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="HomeNameText" Text="A2" FontSize="25" FontWeight="Bold" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock x:Name="HomeScoreText" Text="0" FontSize="50" FontWeight="Bold" />
                                        <TextBlock x:Name="HomeFoulsText" Text="Falli 0" Margin="14,23,0,0" FontSize="18" FontWeight="SemiBold" Foreground="#475569" />
                                    </StackPanel>
                                </StackPanel>
                                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="+1" Width="54" Height="34" FontSize="15" Margin="0,0,6,6" Click="HomePlusOne_Click" />
                                    <Button Content="+2" Width="54" Height="34" FontSize="15" Margin="0,0,6,6" Click="HomePlusTwo_Click" />
                                    <Button Content="+3" Width="54" Height="34" FontSize="15" Margin="0,0,6,6" Click="HomePlusThree_Click" />
                                    <Button Content="-1" Width="54" Height="34" FontSize="15" Margin="0,0,6,6" Click="HomeMinusOne_Click" />
                                    <Button Content="F+" Width="54" Height="34" FontSize="15" Margin="0,0,6,6" Click="HomeTeamFoulPlus_Click" />
                                    <Button Content="F-" Width="54" Height="34" FontSize="15" Margin="0,0,0,6" Click="HomeTeamFoulMinus_Click" />
                                </WrapPanel>
                            </Grid>
                            <DataGrid x:Name="HomeLivePlayersGrid"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      HeadersVisibility="Column"
                                      RowHeight="42"
                                      AlternatingRowBackground="#f9fafb">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding JerseyNumber}" Width="34" />
                                    <DataGridTemplateColumn Header="Giocatore" Width="112">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding PlayerName}" TextWrapping="Wrap" FontSize="12" LineHeight="14" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Pt" Binding="{Binding Points}" Width="36" />
                                    <DataGridTextColumn Header="F" Binding="{Binding Fouls}" Width="32" />
                                    <DataGridTemplateColumn Header="Punti" Width="184">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="+1" Width="40" Height="32" FontSize="14" Margin="0,0,5,0" Click="PlayerPlusOne_Click" />
                                                    <Button Content="+2" Width="40" Height="32" FontSize="14" Margin="0,0,5,0" Click="PlayerPlusTwo_Click" />
                                                    <Button Content="+3" Width="40" Height="32" FontSize="14" Margin="0,0,5,0" Click="PlayerPlusThree_Click" />
                                                    <Button Content="-1" Width="40" Height="32" FontSize="14" Click="PlayerMinusOne_Click" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Falli" Width="92">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="+" Width="40" Height="32" FontSize="16" Margin="0,0,5,0" Click="PlayerFoulPlus_Click" />
                                                    <Button Content="-" Width="40" Height="32" FontSize="16" Click="PlayerFoulMinus_Click" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Azioni" Width="158">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Dunk" Width="58" Height="32" FontSize="12" Margin="0,0,5,0" Click="PlayerDunk_Click" />
                                                    <Button Content="Block" Width="58" Height="32" FontSize="12" Click="PlayerBlock_Click" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <ComboBox x:Name="HomeScorerCombo" Visibility="Collapsed" DisplayMemberPath="DisplayName" />
                        </Grid>
                    </Border>

                    <Border x:Name="ClockLivePanel" Grid.Row="1" Grid.Column="1" Margin="12,0" Padding="12" Background="#111827">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Periodo" Foreground="#cbd5e1" HorizontalAlignment="Center" FontSize="15" />
                            <Border Width="132" Height="36" Margin="0,5,0,0" Background="#f8fafc" BorderBrush="#64748b" BorderThickness="1" HorizontalAlignment="Center">
                                <ComboBox x:Name="PeriodCombo"
                                          BorderThickness="0"
                                          Background="#f8fafc"
                                          FontSize="15"
                                          FontWeight="SemiBold"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          SelectionChanged="PeriodCombo_SelectionChanged">
                                    <ComboBoxItem Content="Tempo 1" Tag="1" IsSelected="True" />
                                    <ComboBoxItem Content="Tempo 2" Tag="2" />
                                    <ComboBoxItem Content="Overtime" Tag="3" />
                                </ComboBox>
                            </Border>
                            <TextBlock x:Name="PeriodText" Text="1" Visibility="Collapsed" />
                            <TextBlock Text="Tempo partita" Margin="0,12,0,0" Foreground="#cbd5e1" HorizontalAlignment="Center" FontSize="14" />
                            <TextBlock x:Name="GameClockText" Text="12:00" Foreground="White" HorizontalAlignment="Center" FontSize="44" FontWeight="Bold" />
                            <Button x:Name="StartPauseButton"
                                    Content="▶ Start / Pausa [Spazio]"
                                    Height="36"
                                    Margin="0,8,0,10"
                                    Background="#16a34a"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    Click="StartPause_Click" />
                            <TextBlock Text="24 secondi" Margin="0,10,0,0" Foreground="#cbd5e1" HorizontalAlignment="Center" FontSize="14" />
                            <TextBlock x:Name="ShotClockText" Text="24" Foreground="#fca5a5" HorizontalAlignment="Center" FontSize="52" FontWeight="Bold" />
                            <Button x:Name="ShotStartPauseButton"
                                    Content="▶ Start / Pausa 24 [0]"
                                    Height="36"
                                    Margin="0,6,0,10"
                                    Background="#16a34a"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    Click="StartPauseShotClock_Click" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="Reset 24 [2]" Height="36" FontSize="14" FontWeight="SemiBold" Click="ResetShotClock_Click" />
                                <Button Grid.Column="2" Content="Reset 14 [1]" Height="36" FontSize="14" FontWeight="SemiBold" Background="#fde68a" Click="ResetShotClock14_Click" />
                            </Grid>
                            <TextBlock x:Name="TeamFoulsText" Text="Falli 0 - 0" Visibility="Collapsed" Margin="0,7,0,0" Foreground="#cbd5e1" HorizontalAlignment="Center" FontSize="15" />
                            </StackPanel>
                        </ScrollViewer>
                            <Border Grid.Row="1" Margin="0,10,0,0" Padding="8" Background="#1f2937" BorderBrush="#475569" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Correzioni e reset" Foreground="#cbd5e1" HorizontalAlignment="Center" Margin="0,0,0,6" FontSize="12" />
                                    <Button Content="Reset tempo partita" Height="32" Background="#f59e0b" Foreground="#111827" FontSize="12" FontWeight="SemiBold" Click="ResetGameClock_Click" />
                                    <Button Content="Imposta tempo manualmente" Height="32" Margin="0,5,0,0" Background="#e5e7eb" Foreground="#111827" FontSize="12" FontWeight="SemiBold" Click="SetGameClock_Click" />
                                    <Button Content="Reset partita" Height="32" Margin="0,5,0,0" Background="#dc2626" Foreground="White" FontSize="12" FontWeight="SemiBold" Click="ResetGame_Click" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border x:Name="AwayLivePanel" Grid.Row="1" Grid.Column="2" Padding="12" Background="White" BorderBrush="#d1d5db" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="AwayNameText" Text="A4" FontSize="25" FontWeight="Bold" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock x:Name="AwayScoreText" Text="0" FontSize="50" FontWeight="Bold" />
                                        <TextBlock x:Name="AwayFoulsText" Text="Falli 0" Margin="14,23,0,0" FontSize="18" FontWeight="SemiBold" Foreground="#475569" />
                                    </StackPanel>
                                </StackPanel>
                                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="+1" Width="54" Height="34" FontSize="15" Margin="0,0,6,6" Click="AwayPlusOne_Click" />
                                    <Button Content="+2" Width="54" Height="34" FontSize="15" Margin="0,0,6,6" Click="AwayPlusTwo_Click" />
                                    <Button Content="+3" Width="54" Height="34" FontSize="15" Margin="0,0,6,6" Click="AwayPlusThree_Click" />
                                    <Button Content="-1" Width="54" Height="34" FontSize="15" Margin="0,0,6,6" Click="AwayMinusOne_Click" />
                                    <Button Content="F+" Width="54" Height="34" FontSize="15" Margin="0,0,6,6" Click="AwayTeamFoulPlus_Click" />
                                    <Button Content="F-" Width="54" Height="34" FontSize="15" Margin="0,0,0,6" Click="AwayTeamFoulMinus_Click" />
                                </WrapPanel>
                            </Grid>
                            <DataGrid x:Name="AwayLivePlayersGrid"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      HeadersVisibility="Column"
                                      RowHeight="42"
                                      AlternatingRowBackground="#f9fafb">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding JerseyNumber}" Width="34" />
                                    <DataGridTemplateColumn Header="Giocatore" Width="112">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding PlayerName}" TextWrapping="Wrap" FontSize="12" LineHeight="14" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Pt" Binding="{Binding Points}" Width="36" />
                                    <DataGridTextColumn Header="F" Binding="{Binding Fouls}" Width="32" />
                                    <DataGridTemplateColumn Header="Punti" Width="184">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="+1" Width="40" Height="32" FontSize="14" Margin="0,0,5,0" Click="PlayerPlusOne_Click" />
                                                    <Button Content="+2" Width="40" Height="32" FontSize="14" Margin="0,0,5,0" Click="PlayerPlusTwo_Click" />
                                                    <Button Content="+3" Width="40" Height="32" FontSize="14" Margin="0,0,5,0" Click="PlayerPlusThree_Click" />
                                                    <Button Content="-1" Width="40" Height="32" FontSize="14" Click="PlayerMinusOne_Click" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Falli" Width="92">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="+" Width="40" Height="32" FontSize="16" Margin="0,0,5,0" Click="PlayerFoulPlus_Click" />
                                                    <Button Content="-" Width="40" Height="32" FontSize="16" Click="PlayerFoulMinus_Click" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Azioni" Width="158">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Dunk" Width="58" Height="32" FontSize="12" Margin="0,0,5,0" Click="PlayerDunk_Click" />
                                                    <Button Content="Block" Width="58" Height="32" FontSize="12" Click="PlayerBlock_Click" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <ComboBox x:Name="AwayScorerCombo" Visibility="Collapsed" DisplayMemberPath="DisplayName" />
                        </Grid>
                    </Border>

                    <Border x:Name="ThreePointContestPanel" Grid.Row="1" Grid.ColumnSpan="3" Padding="18" Visibility="Collapsed" Background="#f3f4f6" BorderBrush="#d1d5db" BorderThickness="1">
                        <Border.Resources>
                            <Style x:Key="ContestStationRadioStyle" TargetType="RadioButton">
                                <Setter Property="Height" Value="72" />
                                <Setter Property="Margin" Value="5" />
                                <Setter Property="FontSize" Value="26" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Foreground" Value="#111827" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="StationBorder" Background="White" BorderBrush="#9ca3af" BorderThickness="2" CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="StationBorder" Property="Background" Value="#ea6324" />
                                                    <Setter TargetName="StationBorder" Property="BorderBrush" Value="#c2410c" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="StationBorder" Property="BorderBrush" Value="#ea6324" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Border.Resources>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>
                            <Border Padding="18" Margin="0,0,12,0" Background="White" BorderBrush="#d1d5db" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="3 Point Contest" Foreground="#111827" FontSize="28" FontWeight="Bold" />
                                <TextBlock Text="Selezione prova" Foreground="#6b7280" Margin="0,4,0,12" />
                                <TextBlock Text="Evento" Foreground="#374151" FontWeight="SemiBold" Margin="0,8,0,6" />
                                <ComboBox x:Name="ContestEventCombo" Height="38" DisplayMemberPath="Name" SelectionChanged="ContestEventCombo_SelectionChanged" />
                                <TextBlock Text="Tiratore" Foreground="#374151" FontWeight="SemiBold" Margin="0,16,0,6" />
                                <ComboBox x:Name="ContestEntryCombo" Height="38" DisplayMemberPath="DisplayName" SelectionChanged="ContestEntryCombo_SelectionChanged" />
                                <TextBlock Text="Prova / fase" Foreground="#374151" FontWeight="SemiBold" Margin="0,16,0,6" />
                                <ComboBox x:Name="ContestRoundCombo" Height="38" DisplayMemberPath="DisplayName" SelectionChanged="ContestRoundCombo_SelectionChanged" />
                                <TextBlock x:Name="ContestDataMessageText" Text="" Foreground="#b45309" TextWrapping="Wrap" Margin="0,14,0,0" />
                                <TextBlock x:Name="ContestStatusText" Text="Stato: pronto" Foreground="#111827" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,0" />
                            </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Padding="18" Margin="0,0,12,0" Background="White" BorderBrush="#d1d5db" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <TextBlock Text="TEMPO" Foreground="#6b7280" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="ContestClockText" Text="60" Foreground="#111827" HorizontalAlignment="Center" FontSize="96" FontWeight="Bold" />
                                <UniformGrid Columns="2" Margin="0,14,0,0">
                                    <Button x:Name="ContestStartPauseButton" Content="Inizia" Height="54" Margin="0,0,6,0" Background="#ea6324" Foreground="White" FontSize="17" FontWeight="SemiBold" Click="ContestStartPause_Click" />
                                    <Button Content="Concludi" Height="54" Margin="6,0,0,0" FontSize="17" FontWeight="SemiBold" Click="ContestFinish_Click" />
                                </UniformGrid>
                                <Button Content="Reset prova" Height="44" Margin="0,12,0,0" FontWeight="SemiBold" Click="ContestReset_Click" />
                            </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Padding="18" Background="White" BorderBrush="#d1d5db" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="POSTAZIONE" Foreground="#6b7280" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" />
                                <UniformGrid Columns="5" Margin="0,12,0,0">
                                    <RadioButton x:Name="ContestStation1Radio" Style="{StaticResource ContestStationRadioStyle}" Content="1" Tag="1" GroupName="ContestStation" Checked="ContestStation_Checked" />
                                    <RadioButton x:Name="ContestStation2Radio" Style="{StaticResource ContestStationRadioStyle}" Content="2" Tag="2" GroupName="ContestStation" Checked="ContestStation_Checked" />
                                    <RadioButton x:Name="ContestStation3Radio" Style="{StaticResource ContestStationRadioStyle}" Content="3" Tag="3" GroupName="ContestStation" Checked="ContestStation_Checked" />
                                    <RadioButton x:Name="ContestStation4Radio" Style="{StaticResource ContestStationRadioStyle}" Content="4" Tag="4" GroupName="ContestStation" Checked="ContestStation_Checked" />
                                    <RadioButton x:Name="ContestStation5Radio" Style="{StaticResource ContestStationRadioStyle}" Content="5" Tag="5" GroupName="ContestStation" Checked="ContestStation_Checked" />
                                </UniformGrid>
                                <TextBlock x:Name="ContestCurrentStationText" Text="Postazione 1: 0" Foreground="#374151" HorizontalAlignment="Center" FontSize="22" FontWeight="SemiBold" Margin="0,18,0,0" />
                                <TextBlock x:Name="ContestTotalScoreText" Text="Totale: 0" Foreground="#ea6324" HorizontalAlignment="Center" FontSize="44" FontWeight="Bold" Margin="0,8,0,18" />
                                <UniformGrid Columns="3">
                                    <Button Content="+1" Height="72" Margin="0,0,6,0" FontSize="26" FontWeight="Bold" Background="#ea6324" Foreground="White" Click="ContestPlusOne_Click" />
                                    <Button Content="+2" Height="72" Margin="6,0" FontSize="26" FontWeight="Bold" Background="#ea6324" Foreground="White" Click="ContestPlusTwo_Click" />
                                    <Button Content="-1" Height="72" Margin="6,0,0,0" FontSize="26" FontWeight="Bold" Click="ContestMinusOne_Click" />
                                </UniformGrid>
                                <UniformGrid Columns="5" Margin="0,20,0,0">
                                    <TextBlock x:Name="ContestStation1Text" Text="1: 0" Foreground="#4b5563" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="ContestStation2Text" Text="2: 0" Foreground="#4b5563" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="ContestStation3Text" Text="3: 0" Foreground="#4b5563" FontWeight="SemiBold" HorizontalAlignment="Center" />
