            <TabItem x:Name="DatabaseTabItem" Header="Database">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Gestione dati locali" FontSize="20" FontWeight="Bold" Foreground="#111827" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Ricarica" Width="110" Height="34" Click="ReloadCrud_Click" />
                        </StackPanel>
                    </DockPanel>

                    <TabControl Grid.Row="1">
                        <TabControl.Resources>
                            <Style TargetType="{x:Type TabItem}">
                                <Setter Property="Padding" Value="12,7" />
                                <Setter Property="Margin" Value="0,0,4,0" />
                                <Style.Triggers>
                                    <Trigger Property="Tag" Value="Setup">
                                        <Setter Property="Background" Value="#eef2ff" />
                                        <Setter Property="Foreground" Value="#3730a3" />
                                    </Trigger>
                                    <Trigger Property="Tag" Value="People">
                                        <Setter Property="Background" Value="#ecfdf5" />
                                        <Setter Property="Foreground" Value="#047857" />
                                    </Trigger>
                                    <Trigger Property="Tag" Value="Match">
                                        <Setter Property="Background" Value="#eff6ff" />
                                        <Setter Property="Foreground" Value="#1d4ed8" />
                                    </Trigger>
                                    <Trigger Property="Tag" Value="Special">
                                        <Setter Property="Background" Value="#fff7ed" />
                                        <Setter Property="Foreground" Value="#c2410c" />
                                    </Trigger>
                                    <Trigger Property="Tag" Value="Decision">
                                        <Setter Property="Background" Value="#fff1f2" />
                                        <Setter Property="Foreground" Value="#be123c" />
                                    </Trigger>
                                    <Trigger Property="Tag" Value="Report">
                                        <Setter Property="Background" Value="#faf5ff" />
                                        <Setter Property="Foreground" Value="#7e22ce" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TabControl.Resources>
                        <TabItem Header="Tornei" Tag="Setup">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="Nuovo torneo" Width="130" Height="34" Margin="0,0,8,0" Click="AddTournament_Click" />
                                    <Button Content="Modifica" Width="90" Height="34" Margin="0,0,8,0" Click="EditTournament_Click" />
                                    <Button Content="Elimina selezionato" Width="150" Height="34" Click="DeleteTournament_Click" />
                                </StackPanel>
                                <DataGrid x:Name="TournamentsGrid"
                                          Grid.Row="1"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          MouseDoubleClick="TournamentsGrid_MouseDoubleClick"
                                          HeadersVisibility="Column"
                                          AlternatingRowBackground="#f9fafb">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="60" />
                                        <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="2*" />
                                        <DataGridTextColumn Header="Descrizione" Binding="{Binding Description}" Width="3*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Edizioni" Tag="Setup">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="Nuova edizione" Width="130" Height="34" Margin="0,0,8,0" Click="AddEdition_Click" />
                                    <Button Content="Modifica" Width="90" Height="34" Margin="0,0,8,0" Click="EditEdition_Click" />
                                    <Button Content="Elimina selezionata" Width="150" Height="34" Click="DeleteEdition_Click" />
                                </StackPanel>
                                <DataGrid x:Name="EditionsGrid"
                                          Grid.Row="1"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          MouseDoubleClick="EditionsGrid_MouseDoubleClick"
                                          HeadersVisibility="Column"
                                          AlternatingRowBackground="#f9fafb">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Id" Binding="{Binding Edition.Id}" Width="60" />
                                        <DataGridTextColumn Header="Torneo" Binding="{Binding TournamentName}" Width="2*" />
                                        <DataGridTextColumn Header="Nome" Binding="{Binding Edition.Name}" Width="2*" />
                                        <DataGridTextColumn Header="Anno" Binding="{Binding Edition.Year}" Width="90" />
                                        <DataGridTextColumn Header="Inizio" Binding="{Binding Edition.StartDate}" Width="110" />
                                        <DataGridTextColumn Header="Fine" Binding="{Binding Edition.EndDate}" Width="110" />
                                        <DataGridTextColumn Header="Stato" Binding="{Binding Edition.Status}" Width="110" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Campi" Tag="Setup">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="Nuovo campo" Width="130" Height="34" Margin="0,0,8,0" Click="AddCourt_Click" />
                                    <Button Content="Modifica" Width="90" Height="34" Margin="0,0,8,0" Click="EditCourt_Click" />
                                    <Button Content="Elimina selezionato" Width="150" Height="34" Click="DeleteCourt_Click" />
                                </StackPanel>
                                <DataGrid x:Name="CourtsGrid"
                                          Grid.Row="1"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          MouseDoubleClick="CourtsGrid_MouseDoubleClick"
                                          HeadersVisibility="Column"
                                          AlternatingRowBackground="#f9fafb">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Id" Binding="{Binding Court.Id}" Width="60" />
                                        <DataGridTextColumn Header="Edizione" Binding="{Binding EditionName}" Width="2*" />
                                        <DataGridTextColumn Header="Nome" Binding="{Binding Court.Name}" Width="2*" />
                                        <DataGridTextColumn Header="Luogo" Binding="{Binding Court.Location}" Width="3*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Squadre" Tag="People">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="Nuova squadra" Width="130" Height="34" Margin="0,0,8,0" Click="AddTeam_Click" />
                                    <Button Content="Modifica" Width="90" Height="34" Margin="0,0,8,0" Click="EditTeam_Click" />
                                    <Button Content="Elimina selezionata" Width="150" Height="34" Click="DeleteTeam_Click" />
                                </StackPanel>
                                <DataGrid x:Name="TeamsGrid"
                                          Grid.Row="1"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          MouseDoubleClick="TeamsGrid_MouseDoubleClick"
                                          HeadersVisibility="Column"
                                          AlternatingRowBackground="#f9fafb">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Id" Binding="{Binding Id}" IsReadOnly="True" Width="60" />
                                        <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="2*" />
                                        <DataGridTextColumn Header="Nome breve" Binding="{Binding ShortName}" Width="*" />
                                        <DataGridTemplateColumn Header="Colore primario" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Width="54"
                                                            Height="22"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Background="{Binding PrimaryColor}"
                                                            BorderBrush="#94a3b8"
                                                            BorderThickness="1"
                                                            CornerRadius="3"
                                                            ToolTip="{Binding PrimaryColor}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Colore secondario" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Width="54"
                                                            Height="22"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Background="{Binding SecondaryColor}"
                                                            BorderBrush="#94a3b8"
                                                            BorderThickness="1"
                                                            CornerRadius="3"
                                                            ToolTip="{Binding SecondaryColor}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Logo" Binding="{Binding LogoPath}" Width="2*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Giocatori" Tag="People">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="Nuovo giocatore" Width="130" Height="34" Margin="0,0,8,0" Click="AddPlayer_Click" />
                                    <Button Content="Modifica" Width="90" Height="34" Margin="0,0,8,0" Click="EditPlayer_Click" />
                                    <Button Content="Elimina selezionato" Width="150" Height="34" Click="DeletePlayer_Click" />
