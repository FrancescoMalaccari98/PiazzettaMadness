<Window x:Class="PiazzettaMadness.App.Forms.TeamFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Squadra"
        Width="560"
        Height="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#f4f6f8">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Text="Squadra" FontSize="24" FontWeight="Bold" Foreground="#111827" />

        <Grid Grid.Row="1" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Nome *" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,12,14" />
            <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Height="34" Margin="0,0,0,14" />

            <TextBlock Text="Nome breve *" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,12,14" />
            <TextBox x:Name="ShortNameBox" Grid.Row="1" Grid.Column="1" Height="34" Margin="0,0,0,14" />

            <TextBlock Text="Colore primario" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,12,14" />
            <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="82" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PrimaryColorBox" Height="34" TextChanged="ColorBox_TextChanged" />
                <Border x:Name="PrimaryColorPreview" Grid.Column="1" Height="34" Margin="8,0" BorderBrush="#94a3b8" BorderThickness="1" CornerRadius="3" />
                <Button Grid.Column="2" Content="Scegli" Height="34" Click="PickPrimaryColor_Click" />
            </Grid>

            <TextBlock Text="Colore secondario" Grid.Row="3" VerticalAlignment="Center" Margin="0,0,12,14" />
            <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="82" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SecondaryColorBox" Height="34" TextChanged="ColorBox_TextChanged" />
                <Border x:Name="SecondaryColorPreview" Grid.Column="1" Height="34" Margin="8,0" BorderBrush="#94a3b8" BorderThickness="1" CornerRadius="3" />
                <Button Grid.Column="2" Content="Scegli" Height="34" Click="PickSecondaryColor_Click" />
            </Grid>

            <TextBlock Text="Logo" Grid.Row="4" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Grid Grid.Row="4" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="LogoPathBox" Height="34" Margin="0,0,8,0" IsReadOnly="True" />
                <Button Grid.Column="1" Content="Sfoglia" Height="34" Margin="0,0,8,0" Click="BrowseLogo_Click" />
                <Button Grid.Column="2" Content="Rimuovi" Height="34" Click="ClearLogo_Click" />
            </Grid>

            <TextBlock Text="Anteprima" Grid.Row="5" VerticalAlignment="Top" Margin="0,16,12,0" />
            <Border Grid.Row="5" Grid.Column="1" Width="160" Height="120" Margin="0,16,0,0" HorizontalAlignment="Left" Background="#e5e7eb" BorderBrush="#cbd5e1" BorderThickness="1">
                <Image x:Name="LogoPreview" Stretch="Uniform" />
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annulla" Width="100" Height="36" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Salva" Width="100" Height="36" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
