<Window x:Class="PiazzettaMadness.App.Forms.GroupTeamFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Squadra nel girone"
        Width="540"
        Height="330"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#f4f6f8">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Text="Squadra nel girone" FontSize="24" FontWeight="Bold" Foreground="#111827" />

        <Grid Grid.Row="1" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Girone *" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,12,14" />
            <ComboBox x:Name="GroupCombo" Grid.Row="0" Grid.Column="1" Height="34" Margin="0,0,0,14" DisplayMemberPath="DisplayName" />

            <TextBlock Text="Squadra *" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,12,14" />
            <ComboBox x:Name="TeamCombo" Grid.Row="1" Grid.Column="1" Height="34" Margin="0,0,0,14" DisplayMemberPath="Name" />

            <TextBlock Text="Seed" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBox x:Name="SeedLabelBox" Grid.Row="2" Grid.Column="1" Height="34" CharacterCasing="Upper" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annulla" Width="100" Height="36" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Salva" Width="100" Height="36" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
