<Window x:Class="PiazzettaMadness.App.Forms.PlayerFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Giocatore"
        Width="620"
        Height="720"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#f4f6f8">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Text="Giocatore" FontSize="24" FontWeight="Bold" Foreground="#111827" />

        <ScrollViewer Grid.Row="1" Margin="0,22,0,0" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

            <TextBlock Text="Nome *" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,12,12" />
            <TextBox x:Name="FirstNameBox" Grid.Row="0" Grid.Column="1" Height="34" Margin="0,0,0,12" />

            <TextBlock Text="Cognome *" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,12,12" />
            <TextBox x:Name="LastNameBox" Grid.Row="1" Grid.Column="1" Height="34" Margin="0,0,0,12" />

            <TextBlock Text="Nickname" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,12,12" />
            <TextBox x:Name="NicknameBox" Grid.Row="2" Grid.Column="1" Height="34" Margin="0,0,0,12" />

            <TextBlock Text="Codice fiscale" Grid.Row="3" VerticalAlignment="Center" Margin="0,0,12,12" />
            <TextBox x:Name="FiscalCodeBox" Grid.Row="3" Grid.Column="1" Height="34" Margin="0,0,0,12" CharacterCasing="Upper" />

            <TextBlock Text="Indirizzo" Grid.Row="4" VerticalAlignment="Center" Margin="0,0,12,12" />
            <TextBox x:Name="AddressBox" Grid.Row="4" Grid.Column="1" Height="34" Margin="0,0,0,12" />

            <TextBlock Text="Telefono" Grid.Row="5" VerticalAlignment="Center" Margin="0,0,12,12" />
            <TextBox x:Name="PhoneNumberBox" Grid.Row="5" Grid.Column="1" Height="34" Margin="0,0,0,12" />

            <TextBlock Text="Email" Grid.Row="6" VerticalAlignment="Center" Margin="0,0,12,12" />
            <TextBox x:Name="EmailBox" Grid.Row="6" Grid.Column="1" Height="34" Margin="0,0,0,12" />

            <TextBlock Text="Data nascita" Grid.Row="7" VerticalAlignment="Center" Margin="0,0,12,12" />
            <DatePicker x:Name="BirthDatePicker" Grid.Row="7" Grid.Column="1" Height="34" Margin="0,0,0,12" DateValidationError="BirthDatePicker_DateValidationError" />

            <TextBlock Text="Foto" Grid.Row="8" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Grid Grid.Row="8" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PhotoPathBox" Height="34" Margin="0,0,8,0" IsReadOnly="True" />
                <Button Grid.Column="1" Content="Sfoglia" Height="34" Margin="0,0,8,0" Click="BrowsePhoto_Click" />
                <Button Grid.Column="2" Content="Rimuovi" Height="34" Click="ClearPhoto_Click" />
            </Grid>

            <TextBlock Text="Anteprima" Grid.Row="9" VerticalAlignment="Top" Margin="0,16,12,0" />
            <Border Grid.Row="9" Grid.Column="1" Width="120" Height="120" Margin="0,16,0,0" HorizontalAlignment="Left" Background="#e5e7eb" BorderBrush="#cbd5e1" BorderThickness="1">
                <Image x:Name="PhotoPreview" Stretch="UniformToFill" />
            </Border>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annulla" Width="100" Height="36" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Salva" Width="100" Height="36" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
