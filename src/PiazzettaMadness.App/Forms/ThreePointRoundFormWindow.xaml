<Window x:Class="PiazzettaMadness.App.Forms.ThreePointRoundFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prova 3 Point Contest"
        Width="560"
        Height="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#f4f6f8">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Text="Prova" FontSize="24" FontWeight="Bold" Foreground="#111827" />
        <Grid Grid.Row="1" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Partecipante *" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,12,12" />
            <ComboBox x:Name="EntryCombo" Grid.Row="0" Grid.Column="1" Height="34" Margin="0,0,0,12" DisplayMemberPath="DisplayName" />
            <TextBlock Text="Numero prova *" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,12,12" />
            <TextBox x:Name="RoundNumberBox" Grid.Row="1" Grid.Column="1" Height="34" Margin="0,0,0,12" />
            <TextBlock Text="Fase" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,12,12" />
            <ComboBox x:Name="RoundTypeCombo" Grid.Row="2" Grid.Column="1" Height="34" Margin="0,0,0,12">
                <ComboBoxItem Content="Qualificazioni" Tag="Qualification" />
                <ComboBoxItem Content="Finale" Tag="Final" />
                <ComboBoxItem Content="Spareggio" Tag="TieBreak" />
            </ComboBox>
            <TextBlock Text="Postazione 1" Grid.Row="3" VerticalAlignment="Center" Margin="0,0,12,12" />
            <TextBox x:Name="Station1Box" Grid.Row="3" Grid.Column="1" Height="34" Margin="0,0,0,12" />
            <TextBlock Text="Postazione 2" Grid.Row="4" VerticalAlignment="Center" Margin="0,0,12,12" />
            <TextBox x:Name="Station2Box" Grid.Row="4" Grid.Column="1" Height="34" Margin="0,0,0,12" />
            <TextBlock Text="Postazione 3" Grid.Row="5" VerticalAlignment="Center" Margin="0,0,12,12" />
            <TextBox x:Name="Station3Box" Grid.Row="5" Grid.Column="1" Height="34" Margin="0,0,0,12" />
            <TextBlock Text="Postazione 4" Grid.Row="6" VerticalAlignment="Center" Margin="0,0,12,12" />
            <TextBox x:Name="Station4Box" Grid.Row="6" Grid.Column="1" Height="34" Margin="0,0,0,12" />
            <TextBlock Text="Postazione 5" Grid.Row="7" VerticalAlignment="Center" Margin="0,0,12,12" />
            <TextBox x:Name="Station5Box" Grid.Row="7" Grid.Column="1" Height="34" Margin="0,0,0,12" />
            <TextBlock Text="Stato live" Grid.Row="8" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock Grid.Row="8" Grid.Column="1" Text="Gestito automaticamente durante la gara" Foreground="#6b7280" VerticalAlignment="Center" />
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annulla" Width="100" Height="36" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Salva" Width="100" Height="36" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
