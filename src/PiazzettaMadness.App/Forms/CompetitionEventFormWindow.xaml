<Window x:Class="PiazzettaMadness.App.Forms.CompetitionEventFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PiazzettaMadness.App.Controls"
        Title="Evento"
        Width="560"
        Height="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#f4f6f8">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Text="Evento" FontSize="24" FontWeight="Bold" Foreground="#111827" />

        <Grid Grid.Row="1" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Edizione *" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,12,14" />
            <ComboBox x:Name="EditionCombo" Grid.Row="0" Grid.Column="1" Height="34" Margin="0,0,0,14" DisplayMemberPath="Name" />

            <TextBlock Text="Nome *" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,12,14" />
            <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" Height="34" Margin="0,0,0,14" />

            <TextBlock Text="Inizio previsto" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,12,14" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,14">
                <DatePicker x:Name="StartDatePicker" Width="160" Height="34" DateValidationError="DatePicker_DateValidationError" />
                <controls:TimePickerControl x:Name="StartTimePicker" Margin="8,0,0,0" />
            </StackPanel>

            <TextBlock Text="Fine prevista" Grid.Row="3" VerticalAlignment="Center" Margin="0,0,12,14" />
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,14">
                <DatePicker x:Name="EndDatePicker" Width="160" Height="34" DateValidationError="DatePicker_DateValidationError" />
                <controls:TimePickerControl x:Name="EndTimePicker" Margin="8,0,0,0" />
            </StackPanel>

            <TextBlock Text="Stato" Grid.Row="4" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ComboBox x:Name="StatusCombo" Grid.Row="4" Grid.Column="1" Height="34">
                <ComboBoxItem Content="Scheduled" />
                <ComboBoxItem Content="Live" />
                <ComboBoxItem Content="Completed" />
                <ComboBoxItem Content="Cancelled" />
            </ComboBox>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annulla" Width="100" Height="36" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Salva" Width="100" Height="36" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
