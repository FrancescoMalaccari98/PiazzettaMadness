<Window x:Class="PiazzettaMadness.App.Forms.ThreePointEntryFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Partecipante 3 Point Contest"
        Width="560"
        Height="390"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#f4f6f8">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Text="Partecipante" FontSize="24" FontWeight="Bold" Foreground="#111827" />

        <Grid Grid.Row="1" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Evento *" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,12,14" />
            <ComboBox x:Name="EventCombo" Grid.Row="0" Grid.Column="1" Height="34" Margin="0,0,0,14" DisplayMemberPath="Name" SelectionChanged="EventCombo_SelectionChanged" />

            <TextBlock Text="Squadra *" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,12,14" />
            <ComboBox x:Name="TeamCombo" Grid.Row="1" Grid.Column="1" Height="34" Margin="0,0,0,14" DisplayMemberPath="Name" SelectionChanged="TeamCombo_SelectionChanged" />

            <TextBlock Text="Giocatore *" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,12,14" />
            <ComboBox x:Name="PlayerCombo" Grid.Row="2" Grid.Column="1" Height="34" Margin="0,0,0,14" DisplayMemberPath="DisplayName" />

            <TextBlock Text="Ordine tiro" Grid.Row="3" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBox x:Name="SeedOrderBox" Grid.Row="3" Grid.Column="1" Height="34" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annulla" Width="100" Height="36" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Salva" Width="100" Height="36" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
