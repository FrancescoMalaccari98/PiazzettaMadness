<Window x:Class="PiazzettaMadness.App.Forms.SponsorFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sponsor"
        Width="620"
        Height="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#f4f6f8">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Text="Sponsor" FontSize="24" FontWeight="Bold" Foreground="#111827" />

        <Grid Grid.Row="1" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Nome *" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,12,14" />
            <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Height="34" Margin="0,0,0,14" />

            <TextBlock Text="Descrizione" Grid.Row="1" VerticalAlignment="Top" Margin="0,0,12,14" />
            <TextBox x:Name="DescriptionBox" Grid.Row="1" Grid.Column="1" Height="80" Margin="0,0,0,14" AcceptsReturn="True" TextWrapping="Wrap" />

            <TextBlock Text="Ordine" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,12,14" />
            <TextBox x:Name="SortOrderBox" Grid.Row="2" Grid.Column="1" Width="100" Height="34" Margin="0,0,0,14" HorizontalAlignment="Left" />

            <TextBlock Text="Attivo" Grid.Row="3" VerticalAlignment="Center" Margin="0,0,12,14" />
            <CheckBox x:Name="IsActiveCheck" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,14" />

            <TextBlock Text="Immagine" Grid.Row="4" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Grid Grid.Row="4" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ImagePathBox" Height="34" Margin="0,0,8,0" IsReadOnly="True" />
                <Button Grid.Column="1" Content="Sfoglia" Height="34" Margin="0,0,8,0" Click="BrowseImage_Click" />
                <Button Grid.Column="2" Content="Rimuovi" Height="34" Click="ClearImage_Click" />
            </Grid>

            <TextBlock Text="Anteprima" Grid.Row="5" VerticalAlignment="Top" Margin="0,16,12,0" />
            <Border Grid.Row="5" Grid.Column="1" Width="260" Height="150" Margin="0,16,0,0" HorizontalAlignment="Left" Background="#e5e7eb" BorderBrush="#cbd5e1" BorderThickness="1">
                <Image x:Name="ImagePreview" Stretch="Uniform" />
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annulla" Width="100" Height="36" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Salva" Width="100" Height="36" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
