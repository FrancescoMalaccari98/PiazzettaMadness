<Window x:Class="PiazzettaMadness.App.Forms.EditionFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edizione"
        Width="560"
        Height="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#f4f6f8">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Text="Edizione" FontSize="24" FontWeight="Bold" Foreground="#111827" />

        <ScrollViewer Grid.Row="1" Margin="0,22,0,0" VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Torneo *" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,12,14" />
            <ComboBox x:Name="TournamentCombo" Grid.Row="0" Grid.Column="1" Height="34" Margin="0,0,0,14" DisplayMemberPath="Name" />

            <TextBlock Text="Nome *" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,12,14" />
            <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" Height="34" Margin="0,0,0,14" />

            <TextBlock Text="Anno *" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,12,14" />
            <TextBox x:Name="YearBox" Grid.Row="2" Grid.Column="1" Height="34" Margin="0,0,0,14" />

            <TextBlock Text="Data inizio" Grid.Row="3" VerticalAlignment="Center" Margin="0,0,12,14" />
            <DatePicker x:Name="StartDatePicker" Grid.Row="3" Grid.Column="1" Height="34" Margin="0,0,0,14" DateValidationError="DatePicker_DateValidationError" />

            <TextBlock Text="Data fine" Grid.Row="4" VerticalAlignment="Center" Margin="0,0,12,14" />
            <DatePicker x:Name="EndDatePicker" Grid.Row="4" Grid.Column="1" Height="34" Margin="0,0,0,14" DateValidationError="DatePicker_DateValidationError" />

            <TextBlock Text="Stato" Grid.Row="5" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ComboBox x:Name="StatusCombo" Grid.Row="5" Grid.Column="1" Height="34" Margin="0,0,0,14">
                <ComboBoxItem Content="Draft" />
                <ComboBoxItem Content="Active" />
                <ComboBoxItem Content="Completed" />
                <ComboBoxItem Content="Cancelled" />
            </ComboBox>

            <TextBlock Text="Console" Grid.Row="6" VerticalAlignment="Center" Margin="0,0,12,0" />
            <CheckBox x:Name="ConsoleActiveBox" Grid.Row="6" Grid.Column="1" Content="Usa questa edizione nella console" VerticalAlignment="Center" />
        </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annulla" Width="100" Height="36" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Salva" Width="100" Height="36" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
