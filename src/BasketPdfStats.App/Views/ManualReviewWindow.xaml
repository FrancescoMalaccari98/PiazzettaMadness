<Window x:Class="BasketPdfStats.App.Views.ManualReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revisione manuale" Height="720" Width="1060"
        MinHeight="500" MinWidth="800" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- Stile TextBox editabile con highlight per modificato/invalido -->
        <Style x:Key="EditCell" TargetType="TextBox">
            <Setter Property="Padding" Value="3,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsModified}" Value="True">
                    <Setter Property="Background" Value="#EBF5FB" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsValid}" Value="False">
                    <Setter Property="Background" Value="#FDECEA" />
                    <Setter Property="BorderBrush" Value="#E74C3C" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Template riusabile: Label + TextBox per una riga stat -->
        <DataTemplate x:Key="StatRowTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12"
                           VerticalAlignment="Center" Foreground="#444444" TextTrimming="CharacterEllipsis" />
                <TextBox Grid.Column="1" Style="{StaticResource EditCell}"
                         Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}" Margin="4,0,0,0" />
            </Grid>
        </DataTemplate>

        <!-- Template singolo gruppo tematico (colore di sfondo + header + righe) -->
        <DataTemplate x:Key="StatGroupTemplate">
            <Border Background="{Binding Background}" CornerRadius="3"
                    Margin="0,2,0,0" Padding="6,4,6,4">
                <StackPanel>
                    <TextBlock Text="{Binding GroupName}" FontSize="10" FontWeight="Bold"
                               Foreground="#555555" Margin="0,0,0,3" />
                    <ItemsControl ItemsSource="{Binding Rows}"
                                  ItemTemplate="{StaticResource StatRowTemplate}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Template sezione giocatore: nome + gruppi colorati -->
        <DataTemplate x:Key="PlayerSectionTemplate">
            <Border Margin="0,0,0,10" Padding="0,0,0,8"
                    BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                               FontSize="12" Margin="0,0,0,4" Foreground="#1A3C5A" />
                    <ItemsControl ItemsSource="{Binding Groups}"
                                  ItemTemplate="{StaticResource StatGroupTemplate}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Tab Control ===== -->
        <TabControl Grid.Row="0">

            <!-- ===== Tab 1: Statistiche giocatori ===== -->
            <TabItem Header="Statistiche giocatori">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Casa -->
                    <GroupBox Grid.Column="0" Margin="0,4,0,0">
                        <GroupBox.Header>
                            <TextBlock Text="{Binding HomeTeamName}" FontWeight="SemiBold" />
                        </GroupBox.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                            <ItemsControl ItemsSource="{Binding HomePlayerSections}"
                                          ItemTemplate="{StaticResource PlayerSectionTemplate}" />
                        </ScrollViewer>
                    </GroupBox>

                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#E0E0E0" />

                    <!-- Ospite -->
                    <GroupBox Grid.Column="2" Margin="0,4,0,0">
                        <GroupBox.Header>
                            <TextBlock Text="{Binding AwayTeamName}" FontWeight="SemiBold" />
                        </GroupBox.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                            <ItemsControl ItemsSource="{Binding AwayPlayerSections}"
                                          ItemTemplate="{StaticResource PlayerSectionTemplate}" />
                        </ScrollViewer>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ===== Tab 2: Squadre e partita ===== -->
            <TabItem Header="Squadre e partita">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">

                        <!-- Punteggio finale -->
                        <TextBlock Text="Punteggio finale" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding EditableFinalScore, UpdateSourceTrigger=PropertyChanged}"
                                 Width="120" HorizontalAlignment="Left" Padding="4,3"
                                 FontSize="13" Margin="0,0,0,16" />

                        <!-- Parziali -->
                        <StackPanel Visibility="{Binding HasPeriods, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Parziali" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Periods}" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="{Binding Period}" Width="30"
                                                       VerticalAlignment="Center" FontSize="12" Foreground="#555" />
                                            <TextBox Text="{Binding EditHome, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="50" Padding="3,2" FontSize="12" Margin="4,0" />
                                            <TextBlock Text="–" VerticalAlignment="Center" Margin="2,0" Foreground="#888" />
                                            <TextBox Text="{Binding EditAway, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="50" Padding="3,2" FontSize="12" Margin="4,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Statistiche squadra affiancate -->
                        <TextBlock Text="Statistiche squadra" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <GroupBox Grid.Column="0">
                                <GroupBox.Header>
                                    <TextBlock Text="{Binding HomeTeamName}" FontWeight="SemiBold" />
                                </GroupBox.Header>
                                <ItemsControl ItemsSource="{Binding HomeTeamRows}"
                                              ItemTemplate="{StaticResource StatRowTemplate}"
                                              Margin="4" />
                            </GroupBox>

                            <GroupBox Grid.Column="2">
                                <GroupBox.Header>
                                    <TextBlock Text="{Binding AwayTeamName}" FontWeight="SemiBold" />
                                </GroupBox.Header>
                                <ItemsControl ItemsSource="{Binding AwayTeamRows}"
                                              ItemTemplate="{StaticResource StatRowTemplate}"
                                              Margin="4" />
                            </GroupBox>
                        </Grid>

                        <!-- Statistiche di partita (comparative senza lato: leadChanges, timesTied…) -->
                        <StackPanel Visibility="{Binding HasGameRows, Converter={StaticResource BoolToVis}}"
                                    Margin="0,16,0,0">
                            <TextBlock Text="Statistiche di partita" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding GameRows}"
                                          ItemTemplate="{StaticResource StatRowTemplate}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Tab 3: Identità giocatori ===== -->
            <TabItem Header="Identità giocatori">
                <Grid Margin="8">
                    <!-- Nessun conflitto -->
                    <TextBlock VerticalAlignment="Top" Margin="0,8,0,0"
                               Foreground="#57606A" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasIdentityItems}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        Nessun conflitto di identità rilevato. Tutti i giocatori sono stati abbinati automaticamente al roster.
                    </TextBlock>

                    <!-- Griglia conflitti identità (riusa IdentityReviewViewModel) -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasIdentityItems}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.DataContext>
                            <Binding Path="IdentityReview" />
                        </Grid.DataContext>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="12" Foreground="#57606A"
                                   Text="Risolvi i conflitti obbligatori (Conflict, NotInPdf) selezionando il giocatore corretto. L'export è bloccato finché restano conflitti aperti." />

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Lato" Binding="{Binding Side}" IsReadOnly="True" Width="55" />
                                <DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" IsReadOnly="True" Width="110" />
                                <DataGridTextColumn Header="N. OCR" Binding="{Binding OcrJersey}" IsReadOnly="True" Width="65" />
                                <DataGridTextColumn Header="Nome OCR" Binding="{Binding OcrName}" IsReadOnly="True" Width="150" />
                                <DataGridTextColumn Header="Conf." Binding="{Binding ConfidenceScore, StringFormat=F2}" IsReadOnly="True" Width="55" />
                                <DataGridTemplateColumn Header="Giocatore DB" Width="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding Candidates}"
                                                      SelectedItem="{Binding SelectedCandidate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      VerticalAlignment="Center">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock>
                                                            <Run Text="#" /><Run Text="{Binding JerseyNumber}" /><Run Text=" " /><Run Text="{Binding LastName}" /><Run Text=" " /><Run Text="{Binding FirstName}" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Azione" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Conferma" Command="{Binding ConfirmCommand}" Margin="2" FontSize="11" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridCheckBoxColumn Header="Risolto" Binding="{Binding Resolved}" IsReadOnly="True" Width="55" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="2" Margin="0,8,0,0" Foreground="#57606A" FontSize="12">
                            <Run Text="Conflitti obbligatori aperti: " />
                            <Run Text="{Binding OpenBlockingCount, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ===== Footer: Conferma / Annulla ===== -->
        <DockPanel Grid.Row="1" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12" Foreground="#57606A"
                       Text="Le celle evidenziate in blu contengono modifiche. Rosso = valore non valido." />
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Annulla"
                    Width="90" Margin="8,0,0,0" IsCancel="True" Click="OnCancel" />
            <Button x:Name="ConfirmButton" DockPanel.Dock="Right" Content="Conferma"
                    Width="110" IsEnabled="{Binding CanConfirm}" Click="OnConfirm"
                    Background="#1A3C5A" Foreground="White" FontWeight="SemiBold" />
        </DockPanel>
    </Grid>
</Window>
