<Window x:Class="BasketPdfStats.App.Views.IdentityReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revisione identità giocatori" Height="520" Width="900"
        MinHeight="360" MinWidth="720" WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Risolvi i conflitti obbligatori (Conflict, NotInPdf) selezionando il giocatore corretto dal roster della squadra. L'export è bloccato finché restano conflitti aperti." />

        <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Lato" Binding="{Binding Side}" IsReadOnly="True" Width="60" />
                <DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" IsReadOnly="True" Width="120" />
                <DataGridTextColumn Header="N. OCR" Binding="{Binding OcrJersey}" IsReadOnly="True" Width="70" />
                <DataGridTextColumn Header="Nome OCR" Binding="{Binding OcrName}" IsReadOnly="True" Width="160" />
                <DataGridTextColumn Header="Conf." Binding="{Binding ConfidenceScore}" IsReadOnly="True" Width="60" />
                <DataGridTemplateColumn Header="Giocatore DB" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding Candidates}"
                                      SelectedItem="{Binding SelectedCandidate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="#" /><Run Text="{Binding JerseyNumber}" /><Run Text=" " /><Run Text="{Binding LastName}" /><Run Text=" " /><Run Text="{Binding FirstName}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Azione" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Conferma" Command="{Binding ConfirmCommand}" Margin="2" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridCheckBoxColumn Header="Risolto" Binding="{Binding Resolved}" IsReadOnly="True" Width="60" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#57606A">
                <Run Text="Conflitti obbligatori aperti: " /><Run Text="{Binding OpenBlockingCount, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Annulla" Width="100" Margin="8,0,0,0" IsCancel="True" Click="OnCancel" />
            <Button x:Name="ConfirmExportButton" DockPanel.Dock="Right" Content="Conferma ed esporta" Width="170"
                    IsEnabled="{Binding CanExport}" Click="OnConfirmExport" />
        </DockPanel>
    </Grid>
</Window>
