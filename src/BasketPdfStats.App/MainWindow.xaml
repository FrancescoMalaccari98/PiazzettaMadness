<Window x:Class="BasketPdfStats.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Basket PDF Stats" Height="690" Width="1040"
        MinHeight="540" MinWidth="880">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="150" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="Seleziona PDF" Width="130" Margin="0,0,8,0" Command="{Binding SelectPdfCommand}" />
                <Button Content="Elabora PDF" Width="120" Command="{Binding ProcessPdfCommand}" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}" TextAlignment="Right" />
                <TextBlock Text="{Binding ResultWindowStatusText}" Foreground="#57606A" FontSize="11" TextAlignment="Right" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" BorderBrush="#D0D7DE" BorderThickness="1" Margin="0,14,0,12" Padding="10" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="PDF selezionato" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" IsReadOnly="True" Text="{Binding SelectedPdfPath}" BorderThickness="0" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ListView Grid.Row="2" ItemsSource="{Binding ProcessedFiles}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="File" Width="250" DisplayMemberBinding="{Binding FileName}" />
                    <GridViewColumn Header="Stato" Width="170" DisplayMemberBinding="{Binding Status}" />
                    <GridViewColumn Header="Hash" Width="150" DisplayMemberBinding="{Binding ShortHash}" />
                    <GridViewColumn Header="JSON" Width="420" DisplayMemberBinding="{Binding OutputJsonPath}" />
                </GridView>
            </ListView.View>
        </ListView>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox Header="Warning / Errori" Margin="0,0,8,0">
                <TextBox Text="{Binding WarningText}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" />
            </GroupBox>
            <GroupBox Grid.Column="1" Header="Percorso JSON generato" Margin="8,0,0,0">
                <TextBox Text="{Binding OutputJsonPath}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" />
            </GroupBox>
        </Grid>

        <!-- Import nel DB -->
        <Border Grid.Row="4" BorderBrush="#D0D7DE" BorderThickness="1" Margin="0,12,0,0" Padding="10" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Match ID" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Column="1" Text="{Binding MatchIdText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center" Padding="4,2" />
                <TextBlock Grid.Column="2" Text="Match Teams" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,8,0" />
                <ComboBox Grid.Column="3" ItemsSource="{Binding MatchOptions}"
                          SelectedItem="{Binding SelectedMatchOption, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          VerticalAlignment="Center" Padding="4,2"
                          IsEnabled="{Binding HasImportService}" />
                <Button Grid.Column="4" Content="Aggiorna" Width="82" Margin="8,0,0,0"
                        Command="{Binding LoadMatchesCommand}" />
                <Button Grid.Column="5" Content="Importa nel DB" Width="130" Margin="8,0,0,0"
                        Command="{Binding ImportToDbCommand}" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="6" Text="{Binding ImportStatusText}" VerticalAlignment="Center"
                           Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#57606A" FontSize="11" />
            </Grid>
        </Border>

        <ProgressBar Grid.Row="5" Height="8" Margin="0,8,0,0" IsIndeterminate="{Binding IsBusy}" />
    </Grid>
</Window>
